# Large generated recordings, datasets, diagnostics, and model output remain local.
/datasets/*
!/datasets/README.md
/training/datasets/*
!/training/datasets/README.md
/training/runs/
/debug/*
/archive/
/output/
/test_runs/
/tmp/
/validation/
__pycache__/
*.py[cod]
*.log
*.bak
*.tmp
.pytest_cache/
.mypy_cache/
.vscode/
.idea/
.venv-rfdetr/
Thumbs.db
.DS_Store

# Never publish credentials, even to a private repository.
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
service-account*.json

